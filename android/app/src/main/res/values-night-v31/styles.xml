<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: el sistema solo acepta un color de fondo y un ícono,
         así que el degradado completo lo pinta Flutter al arrancar. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>
